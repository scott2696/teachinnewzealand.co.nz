/* ==========================================================================
   Pokies Kiwi — site.css
   Palette: pounamu green (ink) + kowhai gold (accent) + warm paper ground.
   No web fonts, no framework, no JS dependency for layout. LCP is text.
   ========================================================================== */

:root{
  --ink:#0A2B26;         /* deep pounamu — headers, headings */
  --ink-2:#061E1A;       /* darker wash for gradients */
  --green:#0F5C4E;       /* mid pounamu — links, accents */
  --green-l:#2E8B75;     /* hover / light accent */
  --gold:#F0B429;        /* kowhai — primary CTA */
  --gold-d:#C4890B;      /* CTA hover / borders */
  --gold-w:#FDF3DC;      /* gold wash for callouts */
  --paua:#1F7A8C;        /* teal secondary accent */
  --coral:#D9482F;       /* warnings, "avoid" states */
  --coral-w:#FCEDE9;
  --bg:#F6F4EF;          /* warm paper */
  --bg-2:#EEEBE3;        /* alt section band */
  --card:#FFFFFF;
  --line:#E2DED4;        /* hairlines */
  --line-2:#CFC9BB;
  --text:#1C2B27;
  --muted:#5C6E69;
  --ok:#127A56;
  --ok-w:#E6F4EE;

  --wrap:1180px;
  --r:14px;              /* card radius */
  --r-s:9px;
  --sh:0 1px 2px rgba(10,43,38,.06), 0 6px 18px rgba(10,43,38,.06);
  --sh-l:0 2px 4px rgba(10,43,38,.07), 0 14px 40px rgba(10,43,38,.10);
  --sans:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,"Noto Sans",sans-serif;
  --mono:ui-monospace,SFMono-Regular,"SF Mono",Menlo,Consolas,monospace;
}

*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth;scroll-padding-top:84px}
body{
  margin:0;background:var(--bg);color:var(--text);
  font:400 17px/1.65 var(--sans);
  text-rendering:optimizeLegibility;-webkit-font-smoothing:antialiased;
}
img{max-width:100%;height:auto;display:block}
a{color:var(--green);text-decoration:none}
a:hover{color:var(--green-l);text-decoration:underline}
.wrap{max-width:var(--wrap);margin:0 auto;padding:0 22px}
.sr{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
:focus-visible{outline:3px solid var(--gold);outline-offset:2px;border-radius:4px}

/* ---------------------------------------------------------------- skip */
.skip{position:absolute;left:-9999px;top:0;z-index:200;background:var(--gold);color:var(--ink);
  padding:10px 18px;font-weight:700;border-radius:0 0 8px 0}
.skip:focus{left:0}

/* ---------------------------------------------------------------- header */
.nav{position:sticky;top:0;z-index:100;background:linear-gradient(180deg,var(--ink) 0%,var(--ink-2) 100%);
  border-bottom:3px solid var(--gold)}
.nav > .wrap{display:flex;align-items:center;gap:18px;min-height:72px}
.brand{display:flex;align-items:center;gap:11px;text-decoration:none;flex:0 0 auto;padding:6px 0}
.brand:hover{text-decoration:none}
.brand-mark{width:38px;height:38px;flex:0 0 38px;border-radius:10px;
  background:linear-gradient(145deg,var(--gold) 0%,var(--gold-d) 100%);
  display:grid;place-items:center;box-shadow:0 2px 0 rgba(0,0,0,.25)}
.brand-mark svg{width:23px;height:23px;display:block}
.brand-txt{display:flex;flex-direction:column;line-height:1.05}
.brand-word{font-size:19px;font-weight:800;letter-spacing:.055em;color:#fff;text-transform:uppercase}
.brand-word em{font-style:normal;color:var(--gold)}
.brand-tag{font-size:10.5px;letter-spacing:.11em;text-transform:uppercase;color:#9DBDB2;margin-top:3px;font-weight:600}

.nav-links{display:flex;align-items:center;gap:2px;margin-left:auto}
.nav-links > a,.nav-trigger{display:inline-flex;align-items:center;gap:5px;padding:9px 12px;border-radius:8px;
  color:#E7EFEC;font-size:14.5px;font-weight:600;text-decoration:none;white-space:nowrap;cursor:pointer}
.nav-links > a:hover,.nav-trigger:hover{background:rgba(255,255,255,.10);color:#fff;text-decoration:none}
.nav-trigger svg{width:11px;height:11px;opacity:.7;transition:transform .18s}
.nav-item{position:relative}
.nav-item:hover .nav-trigger svg,.nav-item:focus-within .nav-trigger svg{transform:rotate(180deg)}
.nav-dd{position:absolute;top:100%;left:0;padding-top:10px;opacity:0;visibility:hidden;
  transform:translateY(-6px);transition:opacity .16s,transform .16s,visibility .16s}
.nav-item:hover .nav-dd,.nav-item:focus-within .nav-dd{opacity:1;visibility:visible;transform:none}
.nav-dd-inner{background:#fff;border:1px solid var(--line);border-radius:12px;box-shadow:var(--sh-l);
  padding:8px;min-width:252px;display:flex;flex-direction:column}
.nav-dd-inner a{padding:9px 12px;border-radius:8px;color:var(--ink);font-size:14.5px;font-weight:600;text-decoration:none}
.nav-dd-inner a:hover{background:var(--bg-2);color:var(--green);text-decoration:none}
.nav-cta{margin-left:8px;background:var(--gold);color:var(--ink)!important;padding:9px 16px!important;
  border-radius:8px;font-weight:800!important;font-size:14px!important}
.nav-cta:hover{background:#FFC64A;text-decoration:none!important}

.menu{display:none;margin-left:auto}
.menu > summary{list-style:none;cursor:pointer;color:#fff;padding:8px;border-radius:8px;
  background:rgba(255,255,255,.10);display:grid;place-items:center}
.menu > summary::-webkit-details-marker{display:none}
.menu-panel{position:absolute;left:0;right:0;top:100%;background:#fff;border-bottom:3px solid var(--gold);
  box-shadow:var(--sh-l);padding:14px 22px 22px;max-height:76vh;overflow:auto}
.menu-panel a{display:block;padding:10px 4px;border-bottom:1px solid var(--line);color:var(--ink);font-weight:600;font-size:15px}
.menu-panel b{display:block;margin:16px 0 4px;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}

/* ---------------------------------------------------------------- hero */
.hero{background:linear-gradient(165deg,var(--ink) 0%,#0D3A32 55%,#10463B 100%);color:#fff;
  padding:38px 0 44px;position:relative;overflow:hidden}
.hero::after{content:"";position:absolute;right:-140px;top:-120px;width:460px;height:460px;border-radius:50%;
  background:radial-gradient(circle,rgba(240,180,41,.16) 0%,rgba(240,180,41,0) 68%);pointer-events:none}
.hero .wrap{position:relative;z-index:1}
.crumbs{display:flex;flex-wrap:wrap;gap:7px;align-items:center;font-size:13px;color:#9DBDB2;margin-bottom:16px}
.crumbs a{color:#9DBDB2;text-decoration:none}
.crumbs a:hover{color:var(--gold);text-decoration:underline}
.crumbs span{opacity:.5}
.hero h1{margin:0 0 14px;font-size:clamp(29px,4.4vw,46px);line-height:1.13;letter-spacing:-.02em;font-weight:800;max-width:20ch}
.hero h1 em{font-style:normal;color:var(--gold)}
.lede{margin:0;font-size:clamp(17px,1.6vw,19.5px);line-height:1.6;color:#D7E4DF;max-width:68ch}
.lede a{color:var(--gold);text-decoration:underline;text-underline-offset:2px}

.hero-by{display:flex;align-items:center;gap:12px;margin:0 0 18px}
.hero-by img,.hero-by .avatar{width:44px;height:44px;border-radius:50%;flex:0 0 44px;border:2px solid rgba(240,180,41,.55);background:var(--green)}
.hero-by .avatar{display:grid;place-items:center;font-weight:800;color:var(--gold);font-size:15px;letter-spacing:.02em}
.hero-by-txt{display:flex;flex-direction:column;gap:3px;font-size:13.5px;color:#B9CFC8}
.hero-by-txt b{color:#fff}
.hero-by-txt a{color:#fff;text-decoration:none;border-bottom:1px dotted rgba(255,255,255,.45)}
.hero-by-txt a:hover{color:var(--gold);border-color:var(--gold)}
.by-meta{display:flex;flex-wrap:wrap;gap:4px 14px;align-items:center;font-family:var(--mono);font-size:11.5px;letter-spacing:.02em;color:#8FB0A7}
.by-meta svg{width:12px;height:12px;flex:0 0 12px}
.by-meta > span{display:inline-flex;align-items:center;gap:5px}

.hero-facts{display:flex;flex-wrap:wrap;gap:9px;margin-top:22px}
.hero-fact{display:inline-flex;align-items:center;gap:7px;background:rgba(255,255,255,.09);
  border:1px solid rgba(240,180,41,.30);color:#EAF2EF;font-size:13px;font-weight:600;
  padding:7px 13px;border-radius:999px;backdrop-filter:blur(2px)}
.hero-fact b{color:var(--gold)}

/* ---------------------------------------------------------------- sections */
.sec{padding:52px 0}
.sec--white{background:var(--card)}
.sec--alt{background:var(--bg-2)}
.sec--ink{background:var(--ink);color:#D7E4DF}
.sec--tight{padding:34px 0}
.sec-head{max-width:74ch;margin:0 0 26px}
.sec-head h2{margin:0 0 10px}
.sec-head p{margin:0;color:var(--muted);font-size:16.5px}
.eyebrow{display:inline-block;font-size:11.5px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;
  color:var(--green);background:var(--ok-w);padding:5px 11px;border-radius:999px;margin-bottom:12px}
.sec--ink .eyebrow{color:var(--gold);background:rgba(240,180,41,.14)}

/* ---------------------------------------------------------------- prose */
.prose{display:grid;grid-template-columns:1fr min(74ch,100%) 1fr}
.prose > *{grid-column:2;min-width:0}
.prose--wide{grid-template-columns:1fr min(100%,100%) 1fr}
/* components that break out of the reading measure to the full wrap width */
.prose > .lb,.prose > .tbl-wrap,.prose > .grid,.prose > .band,.prose > .steps,
.prose > .spec,.prose > .toc,.prose > .abox,.prose > .strip,.prose > .take{grid-column:1 / -1}
.prose h2{font-size:clamp(23px,2.7vw,31px);line-height:1.22;letter-spacing:-.015em;color:var(--ink);
  margin:44px 0 14px;font-weight:800;scroll-margin-top:88px}
.prose h2:first-child{margin-top:0}
.prose h3{font-size:clamp(18.5px,2vw,22px);line-height:1.3;color:var(--ink);margin:32px 0 10px;font-weight:750;scroll-margin-top:88px}
.prose h4{font-size:17px;color:var(--ink);margin:24px 0 8px;font-weight:700}
.prose p{margin:0 0 17px}
.prose ul,.prose ol{margin:0 0 18px;padding-left:1.35em}
.prose li{margin:0 0 9px}
.prose li::marker{color:var(--green)}
.prose strong{color:var(--ink);font-weight:700}
.prose a{text-decoration:underline;text-underline-offset:2px;text-decoration-thickness:1px;
  text-decoration-color:rgba(15,92,78,.35)}
.prose a:hover{text-decoration-color:var(--green-l)}
.sec--ink .prose h2,.sec--ink .prose h3,.sec--ink .prose strong{color:#fff}
.sec--ink .prose a{color:var(--gold)}
.prose blockquote{margin:24px 0;padding:16px 20px;border-left:4px solid var(--gold);background:var(--gold-w);
  border-radius:0 var(--r-s) var(--r-s) 0;font-size:16.5px}
.prose blockquote p:last-child{margin:0}
.prose figure{margin:26px 0}
.prose figcaption{font-size:13.5px;color:var(--muted);margin-top:8px}
.prose hr{border:0;border-top:1px solid var(--line);margin:38px 0}

/* ---------------------------------------------------------------- tables */
.tbl-wrap{overflow-x:auto;margin:0 0 24px;border:1px solid var(--line);border-radius:var(--r);background:#fff;
  -webkit-overflow-scrolling:touch}
table.cmp{border-collapse:collapse;width:100%;min-width:640px;font-size:14.5px}
table.cmp caption{caption-side:top;text-align:left;padding:14px 16px 0;font-size:13px;color:var(--muted);font-weight:600}
table.cmp th,table.cmp td{padding:12px 14px;text-align:left;border-bottom:1px solid var(--line);vertical-align:top}
table.cmp thead th{background:var(--ink);color:#fff;font-size:12px;letter-spacing:.07em;text-transform:uppercase;
  font-weight:700;border-bottom:0;position:sticky;top:0}
table.cmp tbody tr:nth-child(even){background:#FAF9F6}
table.cmp tbody tr:hover{background:var(--gold-w)}
table.cmp tbody tr:last-child td{border-bottom:0}
table.cmp td b,table.cmp td strong{color:var(--ink)}
.t-num{font-family:var(--mono);font-size:13.5px;white-space:nowrap}
.t-yes{color:var(--ok);font-weight:700}
.t-no{color:var(--coral);font-weight:700}

/* ---------------------------------------------------------------- leaderboard */
/* first-person note from the page author, sits directly under an H2 */
.take{display:flex;gap:15px;align-items:flex-start;background:var(--gold-w);
  border:1px solid #EFD9A0;border-left:4px solid var(--gold);border-radius:var(--r);
  padding:18px 22px;margin:0 0 26px}
.take-av{flex:0 0 40px;width:40px;height:40px;border-radius:50%;background:var(--ink);
  color:var(--gold);font-weight:800;font-size:14px;display:grid;place-items:center;letter-spacing:.02em}
.take-b{min-width:0}
.take-by{display:block;font-size:11.5px;font-weight:800;letter-spacing:.09em;text-transform:uppercase;
  color:var(--gold-d);margin-bottom:7px}
.take p{margin:0 0 12px;font-size:16.5px;line-height:1.62;color:var(--text)}
.take p:last-child{margin:0}
.take strong{color:var(--ink)}
.take a{color:var(--green)}
.lb{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:12px}
.lb-row{position:relative;display:grid;
  grid-template-columns:44px minmax(190px,1.25fr) minmax(150px,1fr) minmax(180px,1.15fr) minmax(168px,auto);
  gap:16px;align-items:center;background:#fff;border:1px solid var(--line);border-radius:var(--r);
  padding:16px 18px;box-shadow:var(--sh);transition:box-shadow .18s,border-color .18s,transform .18s}
.lb-row:hover{box-shadow:var(--sh-l);border-color:var(--line-2);transform:translateY(-1px)}
.lb-row--feat{border:2px solid var(--gold);box-shadow:0 3px 0 rgba(196,137,11,.22),var(--sh-l)}
.lb-row--feat::before{content:"Our #1 pick";position:absolute;top:-11px;left:18px;background:var(--gold);color:var(--ink);
  font-size:10.5px;font-weight:800;letter-spacing:.10em;text-transform:uppercase;padding:3px 10px;border-radius:999px}
.lb-cover{position:absolute;inset:0;z-index:1;border-radius:var(--r)}
.lb-row > *:not(.lb-cover){position:relative;z-index:2}
.lb-rank{font-family:var(--mono);font-size:20px;font-weight:700;color:var(--line-2);text-align:center}
.lb-row--feat .lb-rank{color:var(--gold-d)}
.lb-brand{display:flex;align-items:center;gap:13px;min-width:0}
.lb-logo{width:78px;height:46px;flex:0 0 78px;object-fit:contain;background:#fff;border:1px solid var(--line);
  border-radius:8px;padding:5px}
.lb-name{font-weight:750;color:var(--ink);font-size:16px;line-height:1.25;min-width:0}
.lb-name a{color:var(--ink);text-decoration:none}
.lb-name a:hover{color:var(--green);text-decoration:underline}
.lb-sub{display:block;font-weight:500;font-size:12.5px;color:var(--muted);margin-top:3px}
.lb-score{display:flex;flex-direction:column;gap:6px}
.lb-score-top{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.lb-num{display:inline-flex;align-items:center;gap:5px;font-family:var(--mono);font-weight:700;color:var(--ink);font-size:15px}
.lb-num svg{width:15px;height:15px;color:var(--gold-d);fill:var(--gold);stroke-width:1.5}
.lb-num span{color:var(--muted);font-weight:400;font-size:12px}
.lb-tag{display:inline-flex;align-items:center;gap:4px;background:var(--ok-w);color:var(--ok);font-size:11px;
  font-weight:700;padding:3px 8px;border-radius:999px;white-space:nowrap}
.lb-tag svg{width:11px;height:11px}
.lb-bar{height:6px;border-radius:999px;background:var(--bg-2);overflow:hidden}
.lb-bar span{display:block;height:100%;border-radius:999px;background:linear-gradient(90deg,var(--green) 0%,var(--gold) 100%)}
.lb-offer-l{display:block;font-size:10.5px;letter-spacing:.11em;text-transform:uppercase;color:var(--muted);font-weight:700;margin-bottom:3px}
.lb-offer-v{display:block;font-size:14.5px;font-weight:700;color:var(--ink);line-height:1.35}
.lb-cta{display:flex;flex-direction:column;align-items:stretch;gap:6px;text-align:center}
.lb-terms{font-size:10.5px;color:var(--muted);line-height:1.4}
.lb-rev{font-size:12px;font-weight:600}

/* buttons */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;
  background:linear-gradient(180deg,#FFC748 0%,var(--gold) 55%,var(--gold-d) 100%);
  color:var(--ink);font-weight:800;font-size:14.5px;letter-spacing:.01em;
  padding:12px 20px;border-radius:9px;border:0;text-decoration:none;cursor:pointer;
  box-shadow:0 2px 0 rgba(140,96,6,.55);transition:filter .16s,transform .12s,box-shadow .12s;white-space:nowrap}
.btn:hover{filter:brightness(1.06);color:var(--ink);text-decoration:none}
.btn:active{transform:translateY(1px);box-shadow:0 1px 0 rgba(140,96,6,.55)}
.btn--ghost{background:transparent;color:var(--green);border:2px solid var(--line-2);box-shadow:none;font-weight:700}
.btn--ghost:hover{border-color:var(--green);background:var(--ok-w);color:var(--green)}
.btn--lg{padding:15px 28px;font-size:16px}
.btn--block{display:flex;width:100%}
.btn--light{background:#fff;color:var(--ink);box-shadow:0 2px 0 rgba(0,0,0,.18)}

/* ---------------------------------------------------------------- cards */
.grid{display:grid;gap:18px}
.grid--2{grid-template-columns:repeat(auto-fit,minmax(300px,1fr))}
.grid--3{grid-template-columns:repeat(auto-fit,minmax(272px,1fr))}
.grid--4{grid-template-columns:repeat(auto-fit,minmax(212px,1fr))}
.card{background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:22px;box-shadow:var(--sh)}
.card h3{margin:0 0 9px;font-size:18px;color:var(--ink);font-weight:750;line-height:1.3}
.card h3 a{color:var(--ink)}
.card p{margin:0 0 12px;font-size:15px;color:var(--text)}
.card p:last-child{margin-bottom:0}
.card-k{display:block;font-family:var(--mono);font-size:26px;font-weight:700;color:var(--green);line-height:1.1;margin-bottom:6px}
.card-l{display:block;font-size:12px;letter-spacing:.10em;text-transform:uppercase;color:var(--muted);font-weight:700}
.card--pick{border-top:4px solid var(--gold)}
.card--pick .card-l{color:var(--gold-d)}

/* pros / cons */
.pc{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:0 0 24px}
.pc > div{border-radius:var(--r);padding:18px 20px;border:1px solid var(--line)}
.pc-pro{background:var(--ok-w);border-color:#BFE0D2!important}
.pc-con{background:var(--coral-w);border-color:#F2CFC6!important}
.pc h4{margin:0 0 11px;font-size:12.5px;letter-spacing:.11em;text-transform:uppercase;font-weight:800}
.pc-pro h4{color:var(--ok)}
.pc-con h4{color:var(--coral)}
.pc ul{margin:0;padding-left:1.15em;font-size:15px}
.pc li{margin:0 0 8px}
.pc li:last-child{margin:0}
.pc-pro li::marker{color:var(--ok)}
.pc-con li::marker{color:var(--coral)}

/* callouts */
.note{display:flex;gap:14px;padding:18px 20px;border-radius:var(--r);margin:0 0 24px;
  border:1px solid var(--line);background:#fff;font-size:15.5px;line-height:1.6}
.note svg{width:21px;height:21px;flex:0 0 21px;margin-top:2px}
.note p{margin:0 0 10px}
.note p:last-child{margin:0}
.note b{display:block;margin-bottom:5px;color:var(--ink);font-size:15px}
.note--tip{background:var(--ok-w);border-color:#BFE0D2}
.note--tip svg{color:var(--ok)}
.note--warn{background:var(--coral-w);border-color:#F2CFC6}
.note--warn svg{color:var(--coral)}
.note--law{background:var(--gold-w);border-color:#EFD9A0}
.note--law svg{color:var(--gold-d)}
.note--info{background:#EDF4F6;border-color:#C7DEE4}
.note--info svg{color:var(--paua)}

/* ---------------------------------------------------------------- TOC */
.toc{background:#fff;border:1px solid var(--line);border-left:4px solid var(--gold);border-radius:var(--r);
  padding:20px 24px;margin:0 0 34px}
.toc > b{display:block;font-size:11.5px;letter-spacing:.13em;text-transform:uppercase;color:var(--muted);
  font-weight:800;margin-bottom:12px}
.toc ol{margin:0;padding-left:1.3em;columns:2;column-gap:34px;font-size:14.5px}
.toc li{margin:0 0 7px;break-inside:avoid}
.toc a{color:var(--ink);text-decoration:none}
.toc a:hover{color:var(--green);text-decoration:underline}

/* ---------------------------------------------------------------- FAQ */
.faq{display:flex;flex-direction:column;gap:10px;margin:0 0 26px}
.faq-i{background:#fff;border:1px solid var(--line);border-radius:var(--r-s);overflow:hidden}
.faq-i[open]{border-color:var(--line-2);box-shadow:var(--sh)}
.faq-i > summary{list-style:none;cursor:pointer;padding:16px 48px 16px 20px;font-weight:700;color:var(--ink);
  font-size:16.5px;position:relative;line-height:1.4}
.faq-i > summary::-webkit-details-marker{display:none}
.faq-i > summary::after{content:"";position:absolute;right:20px;top:22px;width:10px;height:10px;
  border-right:2.5px solid var(--green);border-bottom:2.5px solid var(--green);transform:rotate(45deg);transition:transform .18s}
.faq-i[open] > summary::after{transform:rotate(-135deg);top:25px}
.faq-i > summary:hover{background:var(--bg)}
.faq-a{padding:0 20px 18px;font-size:16px;line-height:1.65;color:var(--text)}
.faq-a p{margin:0 0 12px}
.faq-a p:last-child,.faq-a ul:last-child{margin-bottom:0}
.faq-a ul{margin:0 0 12px;padding-left:1.25em}

/* ---------------------------------------------------------------- author box */
.abox{display:flex;gap:20px;background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:24px;
  box-shadow:var(--sh);margin:0 0 24px}
.abox .avatar,.abox img{width:76px;height:76px;flex:0 0 76px;border-radius:50%;object-fit:cover;
  background:var(--ink);display:grid;place-items:center;color:var(--gold);font-weight:800;font-size:23px}
.abox-b{min-width:0}
.abox-b b{display:block;font-size:18px;color:var(--ink)}
.abox-b .role{display:block;font-size:13px;color:var(--green);font-weight:700;margin:3px 0 10px;
  letter-spacing:.03em;text-transform:uppercase}
.abox-b p{margin:0 0 10px;font-size:15px;color:var(--text)}
.abox-b p:last-child{margin:0}
.abox-links{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}
.abox-links span{background:var(--bg-2);color:var(--muted);font-size:11.5px;font-weight:600;padding:4px 10px;border-radius:999px}

/* ---------------------------------------------------------------- CTA band */
.band{background:linear-gradient(150deg,var(--ink) 0%,#10463B 100%);color:#fff;border-radius:var(--r);
  padding:34px 36px;margin:0 0 26px;position:relative;overflow:hidden}
.band::after{content:"";position:absolute;right:-90px;bottom:-110px;width:320px;height:320px;border-radius:50%;
  background:radial-gradient(circle,rgba(240,180,41,.18) 0%,rgba(240,180,41,0) 70%)}
.band > *{position:relative;z-index:1}
.band h2,.band h3{color:#fff;margin:0 0 10px}
.band p{color:#C6DAD3;margin:0 0 18px;max-width:62ch;font-size:16.5px}
.band .btn{margin-right:10px}
.band-terms{display:block;margin-top:14px;font-size:12px;color:#8FB0A7}

/* sticky mobile CTA */
.sticky{display:none}

/* disclosure strip */
.disclosure{background:var(--bg-2);border-bottom:1px solid var(--line);font-size:12.5px;color:var(--muted);
  padding:9px 0;line-height:1.5}
.disclosure .wrap{display:flex;gap:10px;align-items:flex-start}
.disclosure svg{width:15px;height:15px;flex:0 0 15px;margin-top:2px;color:var(--gold-d)}
.disclosure a{color:var(--green);text-decoration:underline}

/* rating pill */
.pill{display:inline-flex;align-items:center;gap:6px;background:var(--ink);color:var(--gold);
  font-family:var(--mono);font-weight:700;font-size:14px;padding:6px 12px;border-radius:8px}
.pill svg{width:14px;height:14px}

/* key-value spec grid */
/* hairlines drawn by the cells themselves, so a partial last row stays white */
.spec{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));background:#fff;
  border:1px solid var(--line);border-radius:var(--r);overflow:hidden;margin:0 0 26px}
.spec > div{padding:15px 17px;box-shadow:1px 0 0 var(--line),0 1px 0 var(--line)}
.spec dt{font-size:11px;letter-spacing:.11em;text-transform:uppercase;color:var(--muted);font-weight:800;margin-bottom:5px}
.spec dd{margin:0;font-size:15px;font-weight:650;color:var(--ink);line-height:1.4}

/* step list */
.steps{counter-reset:s;list-style:none;padding:0;margin:0 0 26px;display:flex;flex-direction:column;gap:14px}
.steps li{counter-increment:s;position:relative;padding:18px 20px 18px 62px;background:#fff;
  border:1px solid var(--line);border-radius:var(--r);font-size:15.5px}
.steps li::before{content:counter(s);position:absolute;left:18px;top:17px;width:30px;height:30px;border-radius:50%;
  background:var(--ink);color:var(--gold);font-family:var(--mono);font-weight:700;font-size:14px;display:grid;place-items:center}
.steps li b{display:block;color:var(--ink);margin-bottom:5px;font-size:16.5px}
.steps li p:last-child{margin:0}

/* logo strip */
.strip{display:flex;flex-wrap:wrap;gap:10px;margin:0 0 24px}
.strip img{width:96px;height:52px;object-fit:contain;background:#fff;border:1px solid var(--line);
  border-radius:9px;padding:7px}

/* ---------------------------------------------------------------- footer */
.foot{background:var(--ink);color:#A9C3BB;font-size:14.5px;padding:48px 0 0}
.foot-top{display:grid;grid-template-columns:minmax(240px,1fr) 2.3fr;gap:40px;padding-bottom:36px}
.foot .brand-tag{color:#7F9E95}
.foot-blurb{margin:14px 0 0;max-width:44ch;color:#A9C3BB;line-height:1.6}
.foot-cols{display:grid;grid-template-columns:repeat(auto-fit,minmax(168px,1fr));gap:28px}
.foot-col b{display:block;color:#fff;font-size:11.5px;letter-spacing:.13em;text-transform:uppercase;margin-bottom:13px}
.foot-col a{display:block;color:#A9C3BB;padding:4px 0;text-decoration:none;font-size:14px}
.foot-col a:hover{color:var(--gold);text-decoration:underline}
.foot-rg{border-top:1px solid rgba(255,255,255,.12);padding:26px 0;font-size:13px;line-height:1.7;color:#94AFA7}
.foot-rg strong{color:#fff}
.foot-rg a{color:var(--gold)}
.foot-badges{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin:0 0 18px}
.foot-badge{display:inline-flex;align-items:center;gap:7px;border:1px solid rgba(255,255,255,.20);
  border-radius:8px;padding:7px 12px;font-size:12px;font-weight:700;color:#D7E4DF}
.foot-badge svg{width:15px;height:15px;color:var(--gold)}
.foot-badge .age{background:var(--coral);color:#fff;border-radius:50%;width:22px;height:22px;display:grid;
  place-items:center;font-size:10px;font-weight:800}
.foot-bot{border-top:1px solid rgba(255,255,255,.12);padding:20px 0;display:flex;flex-wrap:wrap;gap:14px;
  justify-content:space-between;font-size:13px;color:#7F9E95}
.foot-bot a{color:#A9C3BB}

/* ---------------------------------------------------------------- responsive */
@media (max-width:1080px){
  .lb-row{grid-template-columns:38px minmax(170px,1.2fr) minmax(140px,.9fr) minmax(160px,auto)}
  .lb-offer{grid-column:2 / -1}
}
@media (max-width:900px){
  .nav-links{display:none}
  .menu{display:block}
  .foot-top{grid-template-columns:1fr;gap:30px}
  .toc ol{columns:1}
  .pc{grid-template-columns:1fr}
}
@media (max-width:720px){
  .take{flex-direction:column;gap:10px;padding:16px 18px}
  body{font-size:16.5px}
  .sec{padding:38px 0}
  .hero{padding:28px 0 34px}
  .lb-row{grid-template-columns:34px 1fr;gap:12px 14px;padding:18px 16px}
  .lb-rank{align-self:start;margin-top:6px}
  .lb-brand{grid-column:2}
  .lb-score,.lb-offer,.lb-cta{grid-column:1 / -1}
  .lb-cta{align-items:stretch}
  .lb-row--feat::before{left:14px}
  .abox{flex-direction:column;gap:14px}
  .band{padding:26px 22px}
  .spec{grid-template-columns:1fr 1fr}
  .sticky{display:flex;position:fixed;left:0;right:0;bottom:0;z-index:90;background:#fff;
    border-top:1px solid var(--line-2);box-shadow:0 -4px 20px rgba(10,43,38,.14);
    padding:10px 14px;gap:12px;align-items:center}
  .sticky img{width:44px;height:30px;object-fit:contain;flex:0 0 44px}
  .sticky-t{flex:1;min-width:0;font-size:12.5px;line-height:1.3;color:var(--muted)}
  .sticky-t b{display:block;color:var(--ink);font-size:14px}
  .sticky .btn{padding:11px 16px;font-size:14px}
  body{padding-bottom:66px}
}
@media (max-width:420px){
  .spec{grid-template-columns:1fr}
  .brand-tag{display:none}
}

@media print{
  .nav,.foot,.sticky,.band,.disclosure{display:none}
  body{background:#fff;font-size:12pt}
  .hero{background:none;color:#000;padding:0}
  .hero h1,.lede{color:#000}
}
@media (prefers-reduced-motion:reduce){
  *{animation:none!important;transition:none!important;scroll-behavior:auto!important}
}
